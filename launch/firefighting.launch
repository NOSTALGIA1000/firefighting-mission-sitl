<launch>
  <arg name="seed" default="4501"/>
  <arg name="record" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="output_dir" default="$(find firefighting_mission)/artifacts/$(arg seed)"/>
  <arg name="world" default="$(find firefighting_mission)/artifacts/$(arg seed)/firefighting.world"/>

  <param name="/use_sim_time" value="true"/>
  <node pkg="firefighting_mission" type="generate_world.py" name="generate_firefighting_world"
        args="--seed $(arg seed) --output $(arg world)" output="screen"/>
  <include file="$(find px4)/launch/mavros_posix_sitl.launch">
    <arg name="vehicle" value="iris"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="sdf" value="$(find firefighting_mission)/models/fire_iris/fire_iris.sdf"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="interactive" value="false"/>
  </include>

  <node pkg="firefighting_mission" type="mission_manager_node.py" name="mission_manager" output="screen"/>
  <node pkg="firefighting_mission" type="navigator_node.py" name="navigator" output="screen"/>
  <node pkg="firefighting_mission" type="safety_monitor_node.py" name="safety_monitor" output="screen"/>
  <node pkg="firefighting_mission" type="target_detector_node.py" name="target_detector" output="screen"/>
  <node pkg="firefighting_mission" type="payload_controller_node.py" name="payload_controller" output="screen"/>
  <node pkg="firefighting_mission" type="mission_recorder_node.py" name="mission_recorder" output="screen">
    <param name="seed" value="$(arg seed)"/>
    <param name="record" value="$(arg record)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
  </node>
</launch>
