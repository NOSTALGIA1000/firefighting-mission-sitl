<launch>
  <arg name="seed" default="4501"/>
  <arg name="record" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="output_dir" default="$(find firefighting_mission)/artifacts/$(arg seed)"/>
  <arg name="world" default="$(find firefighting_mission)/artifacts/$(arg seed)/firefighting.world"/>
  <arg name="mavros_prefix" default="/mavros"/>
  <arg name="scan_topic" default="/iris_0/scan"/>

  <param name="/use_sim_time" value="true"/>
  <node pkg="firefighting_mission" type="start_sitl.sh" name="firefighting_sitl"
        args="$(arg seed) $(arg world) $(arg gui)" output="screen" required="true"/>

  <node pkg="firefighting_mission" type="mission_manager_node.py" name="mission_manager"
        output="screen" required="true"><param name="mavros_prefix" value="$(arg mavros_prefix)"/></node>
  <node pkg="firefighting_mission" type="mavros_bridge_node.py" name="mavros_bridge" output="screen"><param name="mavros_prefix" value="$(arg mavros_prefix)"/></node>
  <node pkg="firefighting_mission" type="navigator_node.py" name="navigator" output="screen"><param name="mavros_prefix" value="$(arg mavros_prefix)"/><param name="scan_topic" value="$(arg scan_topic)"/></node>
  <node pkg="firefighting_mission" type="safety_monitor_node.py" name="safety_monitor" output="screen"><param name="mavros_prefix" value="$(arg mavros_prefix)"/><param name="scan_topic" value="$(arg scan_topic)"/></node>
  <node pkg="firefighting_mission" type="target_detector_node.py" name="target_detector" output="screen"/>
  <node pkg="firefighting_mission" type="payload_controller_node.py" name="payload_controller" output="screen"><param name="mavros_prefix" value="$(arg mavros_prefix)"/></node>
  <node pkg="firefighting_mission" type="supply_drop.py" name="supply_drop" output="screen"><param name="mavros_prefix" value="$(arg mavros_prefix)"/></node>
  <node pkg="firefighting_mission" type="mission_recorder_node.py" name="mission_recorder" output="screen">
    <param name="seed" value="$(arg seed)"/>
    <param name="record" value="$(arg record)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="mavros_prefix" value="$(arg mavros_prefix)"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
  </node>
</launch>
